---
import { render } from "astro:content";
import Landing from "@layouts/Landing.astro";
import Listing from "@layouts/Listing.astro";
import { getRootPages } from "@lib/getRootPages";

const { slug } = Astro.params;
const { entry } = Astro.props;
const { Content } = await render(entry);
export async function getStaticPaths() { return getRootPages(); }
---
{!slug ? <Landing><Content /></Landing> : <Listing frontmatter={entry.data} slug={slug}><Content /></Listing>}
