---
import Landing from "@layouts/Landing.astro";
import Grid from "@components/directory/Grid.astro";
---
<Landing title="技术动态" description="按事件日期查看 AI 模型发布、开源更新、研究与工程实践。">
  <header class="browse-header">
    <h1>技术动态</h1>
    <p>按日期和技术主题查阅模型、开源项目与研究的具体进展。</p>
  </header>
  <Grid mode="timeline" />
</Landing>
