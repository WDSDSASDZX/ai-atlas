---
import Landing from "@layouts/Landing.astro";
import Grid from "@components/directory/Grid.astro";
---
<Landing title="资料库" description="查找 AI 模型、开源项目、技术动态和工程实践笔记。">
  <header class="browse-header">
    <h1>资料库</h1>
    <p>按技术主题、项目或关键词找版本、工具和实践笔记。</p>
  </header>
  <Grid mode="library" />
</Landing>
