---
import { Icon } from "astro-icon/components";
import UiTag from "@components/ui/tags/Tag.astro";
import { withBase } from "@util/paths";
import { availabilityLabels, categories, entryPath, isEdition, opennessLabels, type DirectoryEntry } from "@lib/editorial";
import { entrySearch } from "@lib/entrySearch";
interface Props { item: DirectoryEntry }
const { item } = Astro.props;
const data = item.data;
const icons = {
  model: "tabler:brain", tool: "tabler:tool", project: "tabler:brand-github",
  news: "tabler:news", thought: "tabler:bulb", note: "tabler:notes",
};
const flags = [data.availability && availabilityLabels[data.availability], data.openness && opennessLabels[data.openness]].filter(Boolean);
const date = data.eventDate ?? data.recordedAt;
---
<article class="listing atlas-card" {...entrySearch(item)}>
  <div class="card-top">
    <span class:list={["card-icon", data.category]}><Icon name={icons[data.category]} /></span>
    <span class="card-category">{isEdition(item) ? "月度导读" : categories[data.category]}</span>
    {data.featured && <span class="card-featured"><Icon name="tabler:star-filled" />推荐</span>}
  </div>
  <h3 class="card-title"><a data-entry-link href={withBase(entryPath(item))}>{data.title}</a></h3>
  <p class="card-description">{data.description}</p>
  {(flags.length > 0 || data.access || data.status) && <p class="card-knowledge">{[...flags, data.access, data.status].filter(Boolean).join(" · ")}</p>}
  {data.note && <p class="card-note"><span>我的评价</span>{data.note}</p>}
  <div class="card-tags">{data.tags.map(tag => <UiTag tag={tag} />)}</div>
  <div class="card-bottom"><span>{data.eventDate ? "事件 " : "收录 "}<time datetime={date}>{date}</time></span>{data.source && <span>{data.source}</span>}</div>
</article>
