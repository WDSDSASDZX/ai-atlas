---
import { Icon } from "astro-icon/components";
import { categories, topicLabels, topicsFor, type DirectoryEntry } from "@lib/editorial";
import config from "@util/themeConfig";
interface Props { entries: DirectoryEntry[]; mode: "timeline" | "library" }
const { entries, mode } = Astro.props;
const isLibrary = mode === "library";
const filters = [["all", "全部"], ...Object.entries(categories)];
const tags = [...new Set(entries.flatMap(item => item.data.tags))].sort((a, b) => a.localeCompare(b, "zh-CN"));
const months = [...new Set(entries.flatMap(item => item.data.eventDate ? [item.data.eventDate.slice(0, 7)] : []))].sort().reverse();
const topics = new Set(entries.flatMap(item => topicsFor(item.data)));
---
<section id="browse" class="browse-tools" aria-label="搜索与筛选">
  <div class="browse-line">
    <label class="atlas-search"><Icon name="tabler:search" /><input id="search" type="search" placeholder="搜索标题、来源、正文…" aria-label="关键词搜索" /></label>
    <button id="clear-filters" type="button" class="quiet-button" hidden>清除筛选</button>
    <p id="result-count" role="status" aria-live="polite">{entries.length} 条{isLibrary ? "记录" : "动态"}</p>
  </div>
  {isLibrary && <div class="category-tabs" role="group" aria-label="按分类筛选">
    {filters.map(([key, label]) => <button type="button" data-category-filter={key} aria-pressed={key === "all" ? "true" : "false"}>{label}<span>{key === "all" ? entries.length : entries.filter(item => item.data.category === key).length}</span></button>)}
  </div>}
  <div class="browse-options">
    <label>事件月份<select id="month-filter"><option value="">全部月份</option>{months.map(month => <option value={month}>{month}</option>)}</select></label>
    <label>主题<select id="topic-filter"><option value="">全部主题</option>{[...topics].map(key => <option value={key}>{topicLabels[key]}</option>)}</select></label>
    {isLibrary && <label>标签<select id="tag-filter"><option value="">全部标签</option>{tags.map(tag => <option value={tag}>{config.directoryData.tags.find(value => value.key === tag)?.name || tag}</option>)}</select></label>}
    <label>排序<select id="sort-filter">
      {isLibrary && <option value="featured">推荐优先</option>}
      <option value="event-newest">事件从新到旧</option><option value="event-oldest">事件从旧到新</option>
      {isLibrary && <><option value="newest">最近收录</option><option value="oldest">最早收录</option><option value="title">名称排序</option></>}
    </select></label>
    {isLibrary && <label class="featured-filter"><input id="featured-filter" type="checkbox" />只看推荐</label>}
  </div>
</section>
