---
import { Icon } from "astro-icon/components";
import { getListings } from "@lib/getListings";
import config from "@util/themeConfig";
const listings = await getListings();
const categories = [{ key: "all", label: "全部" }, { key: "model", label: "模型" }, { key: "tool", label: "工具" }, { key: "project", label: "开源项目" }, { key: "news", label: "资讯" }];
const allTags = [...new Set(listings.flatMap(item => item.data.tags))].sort((a, b) => a.localeCompare(b, "zh-CN"));
---
<section class="atlas-toolbar not-prose" aria-labelledby="library-heading">
  <div class="library-heading"><div><p class="eyebrow">THE COLLECTION</p><h2 id="library-heading">我的 AI 信息库</h2></div><p>好用的留下，重要的记下。</p></div>
  <div class="filter-top">
    <div class="category-tabs" role="group" aria-label="按分类筛选">
      {categories.map(category => <button type="button" data-category-filter={category.key} aria-pressed={category.key === "all" ? "true" : "false"}>{category.label}<span>{category.key === "all" ? listings.length : listings.filter(item => item.data.category === category.key).length}</span></button>)}
    </div>
    <label class="atlas-search"><Icon name="tabler:search" /><input id="search" type="search" placeholder="搜索名称、标签、笔记…" aria-label="搜索信息库" /><kbd>Ctrl K</kbd></label>
  </div>
  <div class="filter-bottom">
    <div class="filter-options">
      <label>标签<select id="tag-filter"><option value="">全部标签</option>{allTags.map(tag => <option value={tag}>{config.directoryData.tags.find(value => value.key === tag)?.name || tag}</option>)}</select></label>
      <label>排序<select id="sort-filter"><option value="featured">推荐优先</option><option value="newest">最近收录</option><option value="oldest">最早收录</option><option value="title">名称排序</option></select></label>
      <label class="featured-filter"><input id="featured-filter" type="checkbox" />只看推荐</label>
    </div>
    <p id="result-count" role="status" aria-live="polite">{listings.length} 条记录</p>
  </div>
</section>
