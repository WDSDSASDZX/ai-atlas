---
import { getListings } from "@lib/getListings";
import Card from "./cards/index.astro";
const listings = (await getListings()).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || b.data.recordedAt.localeCompare(a.data.recordedAt) || a.data.title.localeCompare(b.data.title, "zh-CN"));
---
<div id="directory-grid" class="atlas-grid not-prose">{listings.map(item => <Card item={item} />)}</div>
<div id="empty-state" class="empty-state not-prose" hidden><h3>还没找到匹配的信息</h3><p>换个关键词，或清除筛选重新看看。</p><button id="reset-filters" type="button" class="secondary-button">清除筛选</button></div>
<script>
  import { initDirectory } from "@lib/directory";
  initDirectory();
</script>
