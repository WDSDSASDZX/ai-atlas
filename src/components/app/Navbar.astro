---
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import config from "@util/themeConfig";
import { withBase } from "@util/paths";
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---
<header class="atlas-header">
  <nav class="atlas-nav" aria-label="主导航">
    <Logo />
    <div class="nav-links">
      {config.header.navbar.links.map(item => <a href={withBase(item.href)}
        class:list={[{ active: currentPath === withBase(item.href).replace(/\/$/, "") }]}
        aria-current={currentPath === withBase(item.href).replace(/\/$/, "") ? "page" : undefined}
        target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.name}</a>)}
    </div>
    <div class="nav-actions">
      <button id="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色"><Icon name="tabler:contrast" /></button>
      <a class="primary-button" href={config.header.actionButton.href} target="_blank" rel="noopener noreferrer"><Icon name="tabler:plus" />添加信息</a>
    </div>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
  button?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("atlas-theme", dark ? "dark" : "light"); } catch {}
  });
</script>
