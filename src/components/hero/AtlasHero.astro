---
import { Icon } from "astro-icon/components";
import EventGroups from "@components/directory/EventGroups.astro";
import RecentUpdates from "@components/directory/RecentUpdates.astro";
import { getListings } from "@lib/getListings";
import { availabilityLabels, byEventDate, categories, entryPath, getEvents, isEdition, topicLabels, topicsFor } from "@lib/editorial";
import { withBase } from "@util/paths";

const listings = await getListings();
const events = getEvents(listings);
const edition = listings.filter(isEdition).sort(byEventDate)[0];
const editionTags = edition?.data.tags.filter(tag => /^\d{4}-\d{2}-月度$/.test(tag)) ?? [];
const issueEvents = editionTags.length ? events.filter(entry => entry.data.tags.some(tag => editionTags.includes(tag))) : events;
const publishedFocus = issueEvents.filter(entry => entry.data.featured);
const focus = [...publishedFocus.filter(entry => entry.data.takeaway), ...publishedFocus.filter(entry => !entry.data.takeaway)].slice(0, 5);
const newest = events.slice(0, 8);
const topicIcons = {
  models: "tabler:brain",
  coding: "tabler:code",
  deployment: "tabler:server",
  rag: "tabler:database",
  training: "tabler:adjustments",
  multimodal: "tabler:photo",
  research: "tabler:flask",
  governance: "tabler:shield",
  industry: "tabler:cpu",
  products: "tabler:tool",
} satisfies Record<keyof typeof topicLabels, string>;
const topicCounts = new Map<string, number>();
for (const entry of listings) {
  for (const topic of topicsFor(entry.data)) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}
const catalog = (Object.keys(topicLabels) as (keyof typeof topicLabels)[]).filter(topic => topicCounts.has(topic));
---
<section class="atlas-brief" data-legacy-library={withBase("library/")} aria-labelledby="atlas-title">
  <div class="brief-intro">
    <h1 id="atlas-title">AI 技术动态与资料库</h1>
    <p>追踪模型、开源项目和开发工具。看清版本改动、技术取舍与验证方法。</p>
    <div class="brief-actions">
      <a class="brief-primary" href={withBase("timeline/")}>查看事件时间线</a>
      <a class="brief-secondary" href={withBase("library/")}>浏览资料库</a>
    </div>
    {events[0]?.data.eventDate && <p class="brief-updated">最新事件 <time datetime={events[0].data.eventDate}>{events[0].data.eventDate}</time></p>}
  </div>
  {edition && <aside class="brief-edition" aria-labelledby="edition-heading">
    <p class="brief-edition-label"><Icon name="tabler:book" />月度导读</p>
    <h2 id="edition-heading">{edition.data.title}</h2>
    <p>{edition.data.description}</p>
    <a class="brief-secondary" href={withBase(entryPath(edition))}>阅读本期导读</a>
  </aside>}
</section>
{focus.length > 0 && <section class="home-focus" aria-labelledby="focus-heading">
  <header class="home-section-heading"><h2 id="focus-heading">本期重点</h2></header>
  <div class="focus-grid">
    {focus.map(item => <article class="focus-card">
      <div class="focus-meta">
        <time datetime={item.data.eventDate}>{item.data.eventDate}</time>
        <span>{item.data.availability ? availabilityLabels[item.data.availability] : categories[item.data.category]}</span>
      </div>
      <h3><a href={withBase(entryPath(item))}>{item.data.title}</a></h3>
      <p>{item.data.takeaway || item.data.description}</p>
    </article>)}
  </div>
</section>}
<RecentUpdates listings={listings} />
<section class="home-latest" aria-labelledby="latest-heading">
  <header class="home-section-heading"><h2 id="latest-heading">最新技术动态</h2><a href={withBase("timeline/")}>查看全部动态</a></header>
  {newest.length > 0 ? <div class="event-groups"><EventGroups entries={newest} /></div> : <p>目前还没有带事件日期的条目。</p>}
</section>
<section class="home-catalog" aria-labelledby="catalog-heading">
  <header class="home-section-heading"><h2 id="catalog-heading">按技术主题浏览</h2><a href={withBase("library/")}>全部资料</a></header>
  <div class="catalog-grid">
    {catalog.map(topic => <a href={withBase("library/") + "?topic=" + topic + "#browse"} class="catalog-link">
      <Icon name={topicIcons[topic]} />
      <strong>{topicLabels[topic]}</strong>
      <span>{topicCounts.get(topic)} 条</span>
    </a>)}
  </div>
</section>
<script>
  const target = document.querySelector<HTMLElement>("[data-legacy-library]")?.dataset.legacyLibrary;
  const filterKeys = ["category", "q", "tag", "sort", "featured", "month", "topic"];
  const params = new URLSearchParams(location.search);
  if (target && filterKeys.some(key => params.has(key))) {
    location.replace(target + location.search + "#browse");
  }
</script>
